<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  entitlements.mac.plist
  Required when building with hardenedRuntime: true.
  Grants the bare minimum entitlements needed by Electron + FFmpeg.
-->
<plist version="1.0">
  <dict>
    <!-- Allow JIT compilation (required by Electron's V8 engine) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required by some Electron internals) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading of dylibs from outside the app bundle (FFmpeg static binary) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>

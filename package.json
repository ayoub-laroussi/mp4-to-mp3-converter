{
  "name": "mp4-to-mp3-converter",
  "version": "1.1.0",
  "description": "Convertisseur MP4 vers MP3 — Windows & macOS",
  "main": "main.js",
  "scripts": {
    "start":          "electron .",
    "dev":            "electron .",
    "build":          "electron-builder --mac",
    "build:dir":      "electron-builder --mac --dir",
    "build:win":      "electron-builder --win",
    "build:win:dir":  "electron-builder --win --dir",
    "build:all":      "electron-builder --mac --win"
  },
  "author": "Bayou",
  "modifiedBy": "Modifié par @syn008 sur Discord",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.bayou.mp4-to-mp3",
    "productName": "MP4 to MP3 Converter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "icon.png",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "dmg": {
      "title": "MP4 to MP3 Converter",
      "backgroundColor": "#0a0a0f",
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MP4 to MP3 Converter"
    }
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  }
}
